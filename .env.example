# AI provider — one of: bedrock (default), anthropic, openai, gateway
AI_PROVIDER=bedrock

# ── Option 1: AWS Bedrock (Claude via your AWS account) ──────────────────────
#
# Recommended: AWS SSO
#   Step 1 — create the profile (first time only):
#     aws configure sso
#     SSO start URL:  <your organization's SSO start URL>
#     SSO region:     us-east-1
#     Account ID:     <your AWS account ID>
#     Role name:      <your role>
#     Profile name:   <choose any name — must match AWS_PROFILE= below>
#   Step 2 — authenticate each session (or run 'make sso'):
#     aws sso login --profile your-profile-name
#   Expired tokens are detected and the client is rebuilt automatically.
#
# Alternative: static credentials (tokens expire without auto-refresh)
#   AWS_ACCESS_KEY_ID=
#   AWS_SECRET_ACCESS_KEY=
#   AWS_SESSION_TOKEN=       # if using temporary STS credentials
#
# Alternative: default boto3 chain (instance profile, ~/.aws/credentials, env vars)
#   Leave AWS_PROFILE and the static credentials above empty.
#
AWS_REGION=us-east-1
AWS_PROFILE=your-sso-profile-name

# The three named model tiers — the single source of truth for model IDs.
# Set these to your own Bedrock application-inference-profile ARNs.
# Cross-region inference IDs (us.anthropic.*) do NOT work with
# application-inference-profile ARNs.
ANTHROPIC_DEFAULT_SONNET_MODEL=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:application-inference-profile/YOUR_SONNET_PROFILE_ID
ANTHROPIC_DEFAULT_HAIKU_MODEL=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:application-inference-profile/YOUR_HAIKU_PROFILE_ID
ANTHROPIC_DEFAULT_OPUS_MODEL=arn:aws:bedrock:us-east-1:YOUR_ACCOUNT_ID:application-inference-profile/YOUR_OPUS_PROFILE_ID

# ── Option 2: Anthropic API directly (no AWS needed) ─────────────────────────
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=            # default https://api.anthropic.com

# ── Option 3: OpenAI / OpenAI-compatible (ChatGPT, Codex, local gateways) ────
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=               # default https://api.openai.com/v1

# ── Option 4: Claude apps gateway (internal, no API key) ─────────────────────
# Reuses the OAuth session the Claude Code CLI caches in the macOS Keychain
# (run `claude` then `/login` with the Cloud gateway first). No API key is ever
# stored. GATEWAY_BASE_URL is an INTERNAL hostname — set it to your org's gateway;
# it is never committed (this repo is public). On Linux/CI without a Keychain,
# supply the token directly via GATEWAY_JWT instead.
# AI_PROVIDER=gateway
# GATEWAY_BASE_URL=https://claude-gateway.your-org.example.com
# GATEWAY_JWT=                   # Linux/CI only: explicit bearer JWT (no Keychain)
# GATEWAY_KEYCHAIN_SERVICE=      # override the CLI's Keychain service name if non-default
# AI_MODEL_ID=claude-sonnet-5    # gateway takes a plain model name, not an ARN

# Active model — defaults to ANTHROPIC_DEFAULT_SONNET_MODEL when empty.
# For anthropic/openai providers this is a plain model name (e.g.
# claude-opus-4-8, gpt-4o), not an ARN.
AI_MODEL_ID=

# Scan behaviour
# Note: target URL, auth URL and credentials are always passed via CLI flags,
# not configured here. See README.md for usage examples.
MAX_DEPTH=5
MAX_PAGES=200
PARALLEL_WORKERS=4
REQUEST_DELAY_MS=100        # ms between requests per domain
BROWSER_HEADLESS=true

# Attack engine
MAX_ATTACK_ITERATIONS=3     # feedback loop iterations per finding
CONFIDENCE_THRESHOLD=0.7    # min AI confidence to report as confirmed

# Out-of-band interaction server (interactsh) — used by the Interactions tab
# and OOB-based agents (SSRF, blind injection). Leave both unset to use the
# ProjectDiscovery public servers (oast.pro / oast.live / oast.site / oast.me).
# Set these to point at a self-hosted interactsh instance for private OOB.
# INTERACTSH_SERVER=https://oast.example.com
# INTERACTSH_TOKEN=your_interactsh_auth_token

# Output
OUTPUT_DIR=./scan-results
REPORT_FORMAT=html,json,markdown
